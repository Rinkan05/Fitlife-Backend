# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - FITLIFE (AWS EC2)
# Copiar este archivo a .env y definir los valores reales en el servidor
# ==============================================================================

# Clave secreta única y aleatoria para producción (nunca compartir)
SECRET_KEY=cambiar-por-una-clave-secreta-de-produccion-muy-larga-y-aleatoria

# En producción siempre debe ser False
DEBUG=False

# IP pública de tu instancia EC2 o nombre de dominio (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_PUBLICA_EC2,tudominio.com

# Base de datos PostgreSQL (RDS o local en la instancia EC2)
DB_NAME=fitlife_db
DB_USER=fitlife_user
DB_PASSWORD=ContraseñaSegura123!
DB_HOST=localhost
DB_PORT=5432

